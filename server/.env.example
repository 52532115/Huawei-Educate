# SafeTAcademy AI backend — example configuration.
#
# Copy to `.env` (never committed) or export these in your process manager.
# This file is the ONLY place a vendor credential is allowed to exist; the app
# that talks to this server carries no vendor key at all.

# --- HTTP -------------------------------------------------------------------
# Bind port. 8787 is the default the app's settings screen assumes for local
# testing.
PORT=8787

# The app's own session token. When empty, authentication is DISABLED and the
# server says so loudly at startup — fine for a loopback demo, never for a
# deployment that anyone else can reach. Rotating this value is how you revoke
# a leaked client without shipping a new build.
APP_TOKEN=

# --- Chat upstream ----------------------------------------------------------
# Any OpenAI-compatible endpoint. Changing model or provider is a server-side
# change; the app never learns which vendor is behind this.
#
# Verified options:
#   DeepSeek   https://api.deepseek.com/v1                        deepseek-flash
#   DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1  qwen3.7-flash
#
# DashScope's base URL is the SAME one the embedding section below uses, so a
# single DashScope key can fill both CHAT_API_KEY and EMBEDDING_API_KEY.
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-flash

# Whether the model may think before answering: true | false | (leave empty).
#
# Set to `false`. Both upstreams this project ships against think BY DEFAULT,
# and that default is wrong here three times over — all three measured on the
# same question, only this switch differing:
#   - the reasoning trace bills at the OUTPUT rate: 216 completion tokens vs 1
#     on qwen3.7-flash;
#   - the app displays only `delta.content`, so the user stares at a blank
#     bubble for the whole trace: 3218 ms vs 456 ms to the same answer;
#   - a trace long enough to exhaust `max_tokens` comes back as a 200 with an
#     EMPTY `content` (`finish_reason: length`) — "the AI replied with nothing".
#
# How it gets sent: the two vendors spell this switch differently, and each
# silently IGNORES the other's spelling (measured — neither one errors), so the
# server sends both and each upstream picks up the one it knows:
#     Qwen / DashScope   enable_thinking: false
#     DeepSeek           thinking: { type: 'disabled' }
# Empty means "send neither", the safe choice only for a vendor that documents
# neither field. `true` mirrors `false`.
#
# `npm run check-upstream` prints the reasoning-token count from a real call,
# which is the only proof the switch actually took effect — the startup log and
# /health report what was SENT, not what the model did with it.
CHAT_ENABLE_THINKING=false

# --- Embedding upstream -----------------------------------------------------
# Independent of the chat upstream on purpose: a balance problem or a leak on
# one side must not take the other down. Leaving EMBEDDING_API_KEY empty is
# supported — /embed then answers 503 and the app falls back to lexical-only
# retrieval, which still answers questions.
#
# Any OpenAI-compatible /embeddings endpoint works; these are the ones verified:
#   DashScope (default)  https://dashscope.aliyuncs.com/compatible-mode/v1  text-embedding-v4|v3   batch 10
#   Zhipu BigModel       https://open.bigmodel.cn/api/paas/v4               embedding-3|2
#   SiliconFlow          https://api.siliconflow.cn/v1                      BAAI/bge-m3
#   Volcengine Ark       https://ark.cn-beijing.volces.com/api/v3           doubao-embedding-*
#   OpenAI               https://api.openai.com/v1                          text-embedding-3-small|large
#   Ollama (self-host)   http://<host>:11434/v1                             bge-m3
#
# Note the root path is NOT uniform: Zhipu is /api/paas/v4, Ark is /api/v3.
# Ollama needs no credential but still needs a NON-EMPTY one here, or the
# endpoint is treated as unconfigured and always answers 503.
# Changing the model invalidates every vector already indexed — see README.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
# Optional: if the model's vector width is known, pin it and mismatched
# responses are rejected instead of silently accepted. 0 means "trust the
# provider".
# Two-sided: a non-zero value is ALSO sent upstream as the `dimensions`
# parameter. Models without Matryoshka support (BAAI/bge-m3) reject that
# parameter, so keep this 0 for them and give up the width check.
EMBEDDING_DIMENSION=0
# Inputs per upstream call. Providers cap batch size (DashScope text-embedding-v3
# is 10); the server splits a larger request into batches and reorders the
# results, so this only affects how many calls are made.
EMBEDDING_BATCH_SIZE=10

# --- Limits -----------------------------------------------------------------
# Fixed-window per-client limit. 0 disables it.
RATE_LIMIT_PER_MINUTE=120
# Per-request upstream timeout, covers connect and read.
UPSTREAM_TIMEOUT_MS=60000

# --- docker compose only ----------------------------------------------------
# The server process ignores these two. `docker compose --profile tls` reads them
# from this same file to configure Caddy, so leaving them here keeps one source
# of truth for the whole deployment.
# API_DOMAIN must actually resolve to this machine, or ACME validation fails and
# Caddy serves no certificate. Unset, it falls back to `localhost` (self-signed,
# browser will warn) — fine on your desk, useless to the handset.
API_DOMAIN=
# Contact address for Let's Encrypt expiry notices. Optional but recommended.
ACME_EMAIL=
